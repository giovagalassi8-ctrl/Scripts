# =============================================================================
# Script: 05_compare_models.R
#
# Purpose:
# Compare the CR, ETD and CTD models using AIC and Akaike weights.
#
# Required RDS objects:
# Each RDS file must contain:
#   model
#   log_likelihood
#   number_of_parameters
#
# Expected parameter counts:
#   CR  = 4
#   ETD = 5
#   CTD = 5
#
# Output:
#   analyses/SSE/Terebridae_model_comparison.csv
# =============================================================================


# Define input and output files.
cr_file <- "Conidae_CR_fit.rds"
etd_file <- "Conidae_ETD_fit.rds"
ctd_file <- "Conidae_CTD_fit.rds"

output_file <- "Conidae_model_comparison.csv"


# Load the model results.
cr_results <- readRDS(cr_file)
etd_results <- readRDS(etd_file)
ctd_results <- readRDS(ctd_file)


# Create the comparison table.
comparison <- data.frame(
  model = c(
    cr_results$model,
    etd_results$model,
    ctd_results$model
  ),
  log_likelihood = c(
    cr_results$log_likelihood,
    etd_results$log_likelihood,
    ctd_results$log_likelihood
  ),
  number_of_parameters = c(
    cr_results$number_of_parameters,
    etd_results$number_of_parameters,
    ctd_results$number_of_parameters
  ),
  stringsAsFactors = FALSE
)


# Calculate AIC.
comparison$AIC <- (
  -2 * comparison$log_likelihood +
    2 * comparison$number_of_parameters
)


# Calculate delta AIC.
comparison$delta_AIC <- (
  comparison$AIC -
    min(comparison$AIC)
)


# Calculate Akaike weights.
relative_likelihood <- exp(
  -0.5 * comparison$delta_AIC
)


comparison$Akaike_weight <- (
  relative_likelihood /
    sum(relative_likelihood)
)


# Sort models from lowest to highest AIC.
comparison <- comparison[
  order(comparison$AIC),
]


row.names(comparison) <- NULL


# Add model rank.
comparison$rank <- seq_len(
  nrow(comparison)
)


# Identify the model with the lowest AIC.
comparison$best_model <- (
  comparison$rank == 1
)


# Add an evidence category based on delta AIC.
comparison$support_category <- ifelse(
  comparison$delta_AIC < 2,
  "substantial support",
  ifelse(
    comparison$delta_AIC < 7,
    "considerably less support",
    "little support"
  )
)


# Save the model comparison.
write.csv(
  comparison,
  output_file,
  row.names = FALSE
)
